# Los .jsonl de datos son append-only: cada corrida agrega lineas al final y
# nunca modifica las anteriores. Ante un conflicto, lo correcto es CONSERVAR LAS
# DE AMBAS corridas, no elegir un lado. Sin esto, el workflow resolvia con
# "-X theirs" y borraba las lineas de la otra corrida (medido en el historial de
# git: hubo commits donde history.jsonl perdio lineas).
data/history.jsonl merge=union
data/ejecuciones.jsonl merge=union
# notificados.jsonl guarda las huellas de lo ya avisado en vivo y se trunca al
# terminar cada corrida. Tambien por union: ante un conflicto, una huella de mas
# solo evita un aviso repetido, una de menos produce un duplicado.
data/notificados.jsonl merge=union
# pendientes.jsonl guarda los avisos que Discord nunca acepto, para que la
# corrida siguiente los mande. NO es append-only (se reescribe cuando se
# entregan), pero igual va por union: ante un conflicto, una linea de mas manda
# un aviso repetido y una de menos deja al operador sin enterarse. El duplicado
# lo filtra leerPendientes() en src/pendientes.mjs.
data/pendientes.jsonl merge=union
# avisos-tecnicos.jsonl guarda que aviso tecnico ya salio hoy, para que una
# condicion que dura dias no mande 7 mensajes identicos diarios. Por union: ante
# un conflicto, una huella de mas solo evita un aviso repetido (y las huellas
# viejas se podan solas a los 7 dias).
data/avisos-tecnicos.jsonl merge=union
# censo.jsonl es la SERIE del censo: una fila por revision con los 12
# indicadores. Es de donde sale la deriva ("hace 7 dias iba en 82,9%") que el
# mensaje le dice al operador, y que antes del 2026-09-23 no existia en ninguna
# parte: la del incidente hubo que reconstruirla a mano desde git. Append-only y
# podado a 45 dias, asi que por union como el resto.
data/censo.jsonl merge=union

# Los workflows se comparan con expresiones regulares dentro de la suite
# (test/aviso-de-falla.test.mjs). Con core.autocrlf=true -- que es lo que tiene
# el clon del operador -- un clon nuevo en Windows los bajaria con CRLF y esas
# aserciones fallarian sin que nada este roto. Medido el 2026-09-23: una
# extraccion de HEAD con la conversion puesta dejaba la suite en 549/550.
*.yml text eol=lf
*.yaml text eol=lf
